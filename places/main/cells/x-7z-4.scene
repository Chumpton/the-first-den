  feetPosition: {x: 52, y: 0, z: -46}
  fx: {script: "fx\npop spray rate=?mobile:40|70 on=disc(.12).c(2.4) life=.9..1.3 v=up(2.6..3.2)+cone(18)*(.6..1.1) size=.05..0.09 acc=grav() col=<.8,.9,1> a=.8>.6:.8>0 sz=$size floor=die r=sprite(droplet,alpha,velocity,.03)\npop sparkle rate=6 on=disc(2.6).c(.7) life=.6..1.2 size=.05..0.08 col=hdr(2.4,2.1,1.2) a=(0>.3:1>0)*flick(6,.5) sz=$size r=sprite(mote,add)"}
