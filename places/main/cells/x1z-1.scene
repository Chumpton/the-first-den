# spawn-scene v2 yaml x1z-1
bear-cub:
  behavior: scripts/fauna-pet.js
  castShadow: true
  feetPosition: {x: 88, y: {terrain: 0.05}, z: -93}
  id: bear-cub
  physics: character
  primitive: {kind: scripted, params: {}, script: scripts/gen/animal-bear.js}
  rotation: {yaw: 74}
  scale: 0.55
  state: {follow: bear-mother, home: {x: 88, z: -93}, mode: idle, "off": {x: 1.8, z: 1.5}, range: 20, scale: 0.55, sp: bear, until: 0, yaw: 74}
  tags: [fauna-ground, interactable, animal, bear]
  visibleRange: {max: 180}
