# spawn-scene v2 yaml x-1z1
garden-crowd:
  audio: {clip: /cdn/moodboard-lowpoly-cozy/sfx-town-square-crowd-murmur-loop.mp3, gain: 0.12, loop: true, maxDistance: 30, spatial: true}
  behavior: scripts/garden-crowd.js
  feetPosition: {x: -82, y: {terrain: 0}, z: 74}
  id: garden-crowd
  physics: none
  state: {}
  tags: [manager]
garden-district:
  castShadow: false
  feetPosition: {x: -82, y: 0.5, z: 78}
  id: garden-district
  material: {pbr: true}
  physics: static
