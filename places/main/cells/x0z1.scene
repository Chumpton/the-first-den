# ==========================================
# 2. THE GREAT GATES OF STORMWIND (z: 95)
# ==========================================
sw-gates:
  children:
    - castShadow: false
      feetPosition: {x: 0, y: 15.5, z: -3.8}
      id: plaque-welcome
      material: {color: "oklch(0.32 0.1 262)"}
      primitive: {depth: 0.08, height: 1.2, kind: box, width: 7.5}
      ui: "<div face=\"front\" class=\"w-full h-full flex flex-col items-center justify-center text-center\" style=\"background:#1f2f6b;border:6px solid #d9b24c;color:#f2d27a;font-family:serif;font-weight:bold;padding:10px\"><div style=\"font-size:320px;letter-spacing:14px;line-height:1\">STORMWIND CITY</div><div style=\"font-size:140px;letter-spacing:8px;margin-top:10px;opacity:.9\">CAPITAL OF THE ALLIANCE</div></div>"
      visibleRange: {max: 250}
    - castShadow: false
      feetPosition: {x: -8.5, y: 20, z: -4.8}
      id: banner-west
      material: {kind: scripted, params: {ax: 0, ay: -0.25, k: 2, reach: 0.06, speed: 1.1}, script: scripts/material-banner-wave.js}
      primitive: {kind: scripted, params: {beast: lion, field: "oklch(0.38 0.14 262)", field2: "oklch(0.31 0.12 262)", h: 7, kind: drape, point: 0.5, trim: "oklch(0.82 0.13 85)", w: 1.8}, script: scripts/gen/town-banner.js}
      visibleRange: {max: 300}
    - castShadow: false
      feetPosition: {x: 8.5, y: 20, z: -4.8}
      id: banner-east
      material: {kind: scripted, params: {ax: 0, ay: -0.25, k: 2, reach: 0.06, speed: 1.1}, script: scripts/material-banner-wave.js}
      primitive: {kind: scripted, params: {beast: lion, field: "oklch(0.38 0.14 262)", field2: "oklch(0.31 0.12 262)", h: 7, kind: drape, point: 0.5, trim: "oklch(0.82 0.13 85)", w: 1.8}, script: scripts/gen/town-banner.js}
      visibleRange: {max: 300}
  feetPosition: {x: 0, y: 0.5, z: 95}
  id: sw-gates
  physics: static
  primitive: {kind: scripted, script: scripts/gen/stormwind-gates.js}
  visibleRange: {max: 700}

