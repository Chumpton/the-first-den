# spawn-scene v2 yaml x0z1
town-crowd:
  audio: {clip: /cdn/moodboard-lowpoly-cozy/sfx-town-square-crowd-murmur-loop.mp3, gain: 0.15, loop: true, maxDistance: 40, spatial: true}
  behavior: scripts/town-crowd.js
  feetPosition: {x: 0, y: {terrain: 0}, z: 100}
  id: town-crowd
  physics: none
  state: {}
  tags: [manager]
town-dragon:
  behavior: scripts/town-dragon.js
  children: [{feetPosition: {x: 0.2, y: 3.4, z: -1.2}, id: ember-tag, text: {color: oklch(0.92 0.12 80), content: Ember, size: 0.8}}]
  feetPosition: {x: 0, y: 22, z: 130}
  id: town-dragon
  physics: none
  primitive: {kind: scripted, script: scripts/gen/roost-dragon.js}
  rotation: {yaw: 0}
  state: {}
  tags: [dragon, town]
  visibleRange: {max: 170}
town-fountain:
  feetPosition: {x: 0, y: {terrain: 0}, z: 100}
  id: town-fountain
  material: {kind: scripted, script: engine/blueprint}
  physics: none
  primitive: {depth: 9, height: 4, kind: box, width: 9}
town-hall:
  feetPosition: {x: 0, y: {terrain: 0}, z: 128}
  id: town-hall
  material: {kind: scripted, script: engine/blueprint}
  physics: none
  primitive: {depth: 12, height: 18, kind: box, width: 16}
town-row-east:
  feetPosition: {x: 26, y: {terrain: 0}, z: 100}
  id: town-row-east
  material: {kind: scripted, script: engine/blueprint}
  physics: none
  primitive: {depth: 40, height: 9, kind: box, width: 10}
town-row-west:
  feetPosition: {x: -26, y: {terrain: 0}, z: 100}
  id: town-row-west
  material: {kind: scripted, script: engine/blueprint}
  physics: none
  primitive: {depth: 40, height: 9, kind: box, width: 10}
town-square:
  feetPosition: {x: 0, y: {terrain: 0}, z: 100}
  id: town-square
  material: {kind: scripted, script: engine/blueprint}
  physics: none
  primitive: {depth: 44, height: 0.3, kind: box, width: 44}
