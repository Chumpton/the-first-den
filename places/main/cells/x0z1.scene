# spawn-scene v2 yaml x0z1
town-crowd:
  audio: {clip: /cdn/moodboard-lowpoly-cozy/sfx-town-square-crowd-murmur-loop.mp3, gain: 0.15, loop: true, maxDistance: 40, spatial: true}
  behavior: scripts/town-crowd.js
  feetPosition: {x: 0, y: {terrain: 0}, z: 100}
  id: town-crowd
  physics: none
  state: {}
  tags: [manager]
town-dragon:
  behavior: scripts/town-dragon.js
  children: [{feetPosition: {x: 0.2, y: 3.4, z: -1.2}, id: ember-tag, text: {color: oklch(0.92 0.12 80), content: Ember, size: 0.8}}]
  feetPosition: {x: 0, y: 22, z: 130}
  id: town-dragon
  physics: none
  primitive: {kind: scripted, script: scripts/gen/roost-dragon.js}
  rotation: {yaw: 0}
  state: {}
  tags: [dragon, town]
  visibleRange: {max: 170}
town-fountain:
  audio: {clip: /cdn/moodboard-lowpoly-cozy/sfx-town-fountain-splash-loop.mp3, gain: 0.18, loop: true, maxDistance: 25, spatial: true}
  feetPosition: {x: 0, y: 0.55, z: 100}
  fx: {script: "fx\npop sheetA rate=?mobile:18|28 on=arc(3.02,360).c(2.36) life=.7..0.85 v=radial(1.1)*(.8..1.2) size=.07..0.12 acc=grav()+drag(.3) col=<.82,.93,1> a=.75>.5:.6>.15 sz=$size r=sprite(droplet,alpha,velocity,.06)\npop sheetB rate=?mobile:10|16 on=arc(1.76,360).c(3.7) life=.55..0.7 v=radial(.9)*(.8..1.2) size=.06..0.1 acc=grav()+drag(.3) col=<.82,.93,1> a=.75>.5:.6>.15 sz=$size r=sprite(droplet,alpha,velocity,.06)"}
  id: town-fountain
  physics: static
  primitive: {kind: scripted, script: scripts/gen/town-fountain.js, seed: 14}
  tags: [town]
  visibleRange: {max: 170}
town-fountain/glow:
  feetPosition: {x: 0, y: 1.2, z: 0}
  id: town-fountain/glow
  light: {color: oklch(0.9 0.05 200), distance: 10, intensity: 3, kind: point}
  parent: town-fountain
town-fountain/jet:
  feetPosition: {x: -0.66, y: 6, z: 0}
  fx: {script: "fx\npop jet rate=?mobile:8|12 on=point() life=.95..1.15 v=<-1.6,2.2,0>*(.9..1.1)+sdir()*.12 size=.06..0.1 acc=grav() col=<.85,.95,1> a=.8>.6:.7>.2 sz=$size r=sprite(droplet,alpha,velocity,.05)"}
  id: town-fountain/jet
  parent: town-fountain
town-fountain/water-basin:
  feetPosition: {x: 0, y: 0.5, z: 0}
  id: town-fountain/water-basin
  material: {color: oklch(0.72 0.08 200), kind: water, opacity: 0.75, waveIntensity: 0.25}
  parent: town-fountain
  primitive: {height: 0.04, kind: cylinder, radialSegments: 40, radiusBottom: 4.56, radiusTop: 4.56}
town-fountain/water-tier1:
  feetPosition: {x: 0, y: 2.34, z: 0}
  id: town-fountain/water-tier1
  material: {color: oklch(0.72 0.08 200), kind: water, opacity: 0.75, waveIntensity: 0.3}
  parent: town-fountain
  primitive: {height: 0.03, kind: cylinder, radialSegments: 32, radiusBottom: 2.85, radiusTop: 2.85}
town-fountain/water-tier2:
  feetPosition: {x: 0, y: 3.68, z: 0}
  id: town-fountain/water-tier2
  material: {color: oklch(0.72 0.08 200), kind: water, opacity: 0.75, waveIntensity: 0.3}
  parent: town-fountain
  primitive: {height: 0.03, kind: cylinder, radialSegments: 24, radiusBottom: 1.61, radiusTop: 1.61}
town-hall:
  feetPosition: {x: 0, y: 0.4156158529396462, z: 130}
  id: town-hall
  physics: static
  primitive: {kind: scripted, params: {roostY: 21.584}, script: scripts/gen/town-hall.js, seed: 15}
  tags: [town, roost]
  visibleRange: {max: 400}
town-market:
  feetPosition: {x: 0, y: 0.55, z: 100}
  id: town-market
  physics: static
  primitive: {kind: scripted, params: {kind: market, stalls: [{awn: oklch(0.62 0.13 40), goods: [apples, pumpkin, carrots], hang: oklch(0.72 0.14 50), x: -13, z: -10}, {awn: oklch(0.62 0.08 195), goods: [bread, cheese, jars], x: -15.5, z: 0.5}, {awn: oklch(0.8 0.12 85), goods: [flowers, flowers, cabbage], hang: oklch(0.66 0.15 350), x: -13, z: 10.5}, {awn: oklch(0.7 0.08 130), goods: [cabbage, lemons, oranges], x: 13, z: -9.5}, {awn: oklch(0.66 0.11 10), goods: [plums, apples, jars], hang: oklch(0.7 0.13 130), x: 15.5, z: 1}, {awn: oklch(0.55 0.06 250), goods: [fish, fish, lemons], x: 12.5, z: 11}]}, script: scripts/gen/town-square.js, seed: 13}
  tags: [town, market]
  visibleRange: {max: 170}
town-road/lamp-light-0:
  feetPosition: {x: -3.6500000000000004, y: 3.75, z: 54}
  id: town-road/lamp-light-0
  light: {color: oklch(0.85 0.1 70), distance: 11, intensity: 3, kind: point}
  parent: town-road
town-road/lamp-light-1:
  feetPosition: {x: 3.6500000000000004, y: 3.75, z: 54}
  id: town-road/lamp-light-1
  light: {color: oklch(0.85 0.1 70), distance: 11, intensity: 3, kind: point}
  parent: town-road
town-square:
  feetPosition: {x: 0, y: 0.55, z: 100}
  id: town-square
  physics: static
  primitive: {kind: scripted, params: {benches: [[-18.5, -8, -90], [-18.5, 8, -90], [18.5, -8, 90], [18.5, 8, 90]], kind: square, planters: [[-6, -20.5, 3, 90], [6, -20.5, 3, 90], [-8, 19.5, 3, 0], [8, 19.5, 3, 0]], poleH: 8.5, poles: [[-20.5, -16], [20.5, -16], [-20.5, 16], [20.5, 16]], strings: [[0, 1], [2, 3], [0, 3], [1, 2]], trees: [[-17, 18.5], [17, 18.5]]}, script: scripts/gen/town-square.js, seed: 12}
  tags: [town]
  visibleRange: {max: 170}
