# spawn-scene v2 yaml x0z1
corridor-road-bp/marker-2:
  castShadow: false
  feetPosition: {x: -5.21, y: 0.05, z: 31.56}
  id: corridor-road-bp/marker-2
  material: {pbr: true}
  parent: corridor-road-bp
  physics: static
  primitive: {kind: scripted, params: {item: marker}, script: scripts/gen/town-lane.js, seed: 22}
  rotation: {yaw: -115.09}
  tags: [town-lane, mile-marker]
  ui: "<div face=\"front\" at=\"0.5 0.52\" width=\"0.32m\" style=\"height:560px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:22px;background:#1f2f6b;border:10px solid #d9b24c;border-radius:26px;color:#f2d27a;font-family:serif;font-weight:700;text-align:center\"><div style=\"width:0;height:0;border-left:46px solid transparent;border-right:46px solid transparent;border-bottom:64px solid #f2d27a\"></div><div style=\"font-size:42px;letter-spacing:4px;line-height:1.05\">STORMWIND</div><div style=\"font-size:100px;letter-spacing:4px;line-height:1.05\">GATE</div><div style=\"font-size:36px;letter-spacing:4px;line-height:1.05\">60 m</div></div>"
  visibleRange: {max: 70}

