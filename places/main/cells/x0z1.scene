# spawn-scene v2 yaml x0z1
# ==============================================================================
# STORMWIND CITY - VALLEY OF HEROES & THE GREAT GATES
# ==============================================================================

# Valley of Heroes Causeway across the Moat
sw-causeway:
  feetPosition: {x: 0, y: 0.55, z: 50}
  id: sw-causeway
  physics: static
  primitive: {depth: 90, height: 1.2, kind: box, width: 16}
  material: {color: "oklch(0.92 0.015 80)", roughness: 0.85}
  visibleRange: {max: 600}

sw-causeway-parapet-w:
  feetPosition: {x: -8, y: 1.15, z: 50}
  id: sw-causeway-parapet-w
  physics: static
  primitive: {depth: 90, height: 1.2, kind: box, width: 0.9}
  material: {color: "oklch(0.95 0.01 85)", roughness: 0.8}
  visibleRange: {max: 450}

sw-causeway-parapet-e:
  feetPosition: {x: 8, y: 1.15, z: 50}
  id: sw-causeway-parapet-e
  physics: static
  primitive: {depth: 90, height: 1.2, kind: box, width: 0.9}
  material: {color: "oklch(0.95 0.01 85)", roughness: 0.8}
  visibleRange: {max: 450}

# 5 Hero Monuments
sw-hero-turalyon:
  children:
    - castShadow: false
      feetPosition: {x: 0, y: 2.2, z: -1.62}
      id: plaque
      material: {color: "oklch(0.32 0.1 262)"}
      primitive: {depth: 0.06, height: 0.55, kind: box, width: 2.8}
      ui: "<div face=\"front\" class=\"w-full h-full flex items-center justify-center text-center\" style=\"background:#1f2f6b;border:4px solid #d9b24c;color:#f2d27a;font-family:serif;font-size:180px;font-weight:bold;letter-spacing:6px\">GENERAL TURALYON</div>"
      visibleRange: {max: 80}
  feetPosition: {x: -6.5, y: 0.55, z: 25}
  id: sw-hero-turalyon
  physics: static
  primitive: {kind: scripted, params: {hero: turalyon}, script: scripts/gen/stormwind-monument.js}
  rotation: {yaw: 25}
  visibleRange: {max: 500}

sw-hero-danath:
  children:
    - castShadow: false
      feetPosition: {x: 0, y: 2.2, z: -1.62}
      id: plaque
      material: {color: "oklch(0.32 0.1 262)"}
      primitive: {depth: 0.06, height: 0.55, kind: box, width: 2.8}
      ui: "<div face=\"front\" class=\"w-full h-full flex items-center justify-center text-center\" style=\"background:#1f2f6b;border:4px solid #d9b24c;color:#f2d27a;font-family:serif;font-size:180px;font-weight:bold;letter-spacing:6px\">DANATH TROLLBANE</div>"
      visibleRange: {max: 80}
  feetPosition: {x: 6.5, y: 0.55, z: 25}
  id: sw-hero-danath
  physics: static
  primitive: {kind: scripted, params: {hero: danath}, script: scripts/gen/stormwind-monument.js}
  rotation: {yaw: -25}
  visibleRange: {max: 500}

sw-hero-alleria:
  children:
    - castShadow: false
      feetPosition: {x: 0, y: 2.2, z: -1.62}
      id: plaque
      material: {color: "oklch(0.32 0.1 262)"}
      primitive: {depth: 0.06, height: 0.55, kind: box, width: 2.8}
      ui: "<div face=\"front\" class=\"w-full h-full flex items-center justify-center text-center\" style=\"background:#1f2f6b;border:4px solid #d9b24c;color:#f2d27a;font-family:serif;font-size:180px;font-weight:bold;letter-spacing:6px\">ALLERIA WINDRUNNER</div>"
      visibleRange: {max: 80}
  feetPosition: {x: -6.5, y: 0.55, z: 50}
  id: sw-hero-alleria
  physics: static
  primitive: {kind: scripted, params: {hero: alleria}, script: scripts/gen/stormwind-monument.js}
  rotation: {yaw: 20}
  visibleRange: {max: 500}

sw-hero-kurdran:
  children:
    - castShadow: false
      feetPosition: {x: 0, y: 2.2, z: -1.62}
      id: plaque
      material: {color: "oklch(0.32 0.1 262)"}
      primitive: {depth: 0.06, height: 0.55, kind: box, width: 2.8}
      ui: "<div face=\"front\" class=\"w-full h-full flex items-center justify-center text-center\" style=\"background:#1f2f6b;border:4px solid #d9b24c;color:#f2d27a;font-family:serif;font-size:180px;font-weight:bold;letter-spacing:6px\">KURDRAN WILDHAMMER</div>"
      visibleRange: {max: 80}
  feetPosition: {x: 6.5, y: 0.55, z: 50}
  id: sw-hero-kurdran
  physics: static
  primitive: {kind: scripted, params: {hero: kurdran}, script: scripts/gen/stormwind-monument.js}
  rotation: {yaw: -20}
  visibleRange: {max: 500}

sw-hero-khadgar:
  children:
    - castShadow: false
      feetPosition: {x: 0, y: 2.2, z: -1.62}
      id: plaque
