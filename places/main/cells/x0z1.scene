town-crowd:
  audio: {clip: /cdn/moodboard-lowpoly-cozy/sfx-town-square-crowd-murmur-loop.mp3, gain: 0.15, loop: true, maxDistance: 40, spatial: true}
  behavior: scripts/town-crowd.js
  feetPosition: {x: 0, y: {terrain: 0}, z: 100}
  id: town-crowd
  physics: none
  state: {}
  tags: [manager]
town-dragon:
  behavior: scripts/town-dragon.js
  children: [{feetPosition: {x: 0.2, y: 3.4, z: -1.2}, id: ember-tag, text: {color: oklch(0.92 0.12 80), content: Ember, size: 0.8}}]
