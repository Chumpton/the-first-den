  visibleRange: {max: 170}
town-fountain:
  audio: {clip: /cdn/moodboard-lowpoly-cozy/sfx-town-fountain-splash-loop.mp3, gain: 0.18, loop: true, maxDistance: 25, spatial: true}
  feetPosition: {x: 0, y: 0.55, z: 100}
  fx: {script: "fx\npop sheetA rate=?mobile:18|28 on=arc(3.02,360).c(2.36) life=.7..0.85 v=radial(1.1)*(.8..1.2) size=.07..0.12 acc=grav()+drag(.3) col=<.82,.93,1> a=.75>.5:.6>.15 sz=$size r=sprite(droplet,alpha,velocity,.06)\npop sheetB rate=?mobile:10|16 on=arc(1.76,360).c(3.7) life=.55..0.7 v=radial(.9)*(.8..1.2) size=.06..0.1 acc=grav()+drag(.3) col=<.82,.93,1> a=.75>.5:.6>.15 sz=$size r=sprite(droplet,alpha,velocity,.06)"}
  id: town-fountain
  physics: static
  primitive: {kind: scripted, script: scripts/gen/town-fountain.js, seed: 14}
  tags: [town]
  visibleRange: {max: 170}
town-fountain/glow:
  feetPosition: {x: 0, y: 1.2, z: 0}
  id: town-fountain/glow
  light: {color: oklch(0.9 0.05 200), distance: 10, intensity: 3, kind: point}
  parent: town-fountain
town-fountain/jet:
  feetPosition: {x: -0.66, y: 6, z: 0}
  fx: {script: "fx\npop jet rate=?mobile:8|12 on=point() life=.95..1.15 v=<-1.6,2.2,0>*(.9..1.1)+sdir()*.12 size=.06..0.1 acc=grav() col=<.85,.95,1> a=.8>.6:.7>.2 sz=$size r=sprite(droplet,alpha,velocity,.05)"}
  id: town-fountain/jet
  parent: town-fountain
