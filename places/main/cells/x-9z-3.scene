# spawn-scene v2 yaml x-9z-3
hearthmere/hearth-city-canal:
  castShadow: false
  feetPosition: {x: -116, y: 0, z: 85}
  id: hearthmere/hearth-city-canal
  parent: hearthmere
  physics: static
  primitive: {kind: scripted, params: {kind: canal, mx: -116, mz: 85}, script: scripts/gen/hearth-city.js}
  visibleRange: {max: 300}
hearthmere/hearth-city-district-3:
  feetPosition: {x: -99.1, y: 0, z: 61.2}
  id: hearthmere/hearth-city-district-3
  parent: hearthmere
  physics: static
  primitive: {kind: scripted, params: {i: 3, kind: district}, script: scripts/gen/hearth-city.js, seed: 4}
  visibleRange: {max: 900}
hearthmere/hearth-city-wall-1:
  feetPosition: {x: -159.34, y: 0, z: 64.76}
  id: hearthmere/hearth-city-wall-1
  parent: hearthmere
  physics: static
