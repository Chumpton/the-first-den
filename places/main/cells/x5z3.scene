# spawn-scene v2 yaml x5z3
sw-keep-gatehouse:
  id: sw-keep-gatehouse
  feetPosition:
    x: 460
    y: 26
    z: 326.8
  physics: static
  visibleRange:
    max: 850
  rotation:
    yaw: 90
  primitive:
    kind: scripted
    params:
      part: gatehouse
    script: scripts/gen/royal-castle.js
sw-throne-room:
  id: sw-throne-room
  feetPosition:
    x: 495.6
    y: 26
    z: 326.8
  physics: static
  visibleRange:
    max: 950
  rotation:
    yaw: 90
  primitive:
    kind: scripted
    params:
      part: keep
    script: scripts/gen/royal-castle.js
  children:
    - castShadow: false
      feetPosition:
        x: 0
        y: 9
        z: 1
      id: throne-light
      light:
        color: oklch(0.88 0.08 75)
        distance: 30
        intensity: 35
        kind: point
    - castShadow: true
      feetPosition:
        x: 0
        y: 40.5
        z: -3.3
      id: keep-spire-banner
      material:
        kind: scripted
        params:
          ax: 0
          ay: -0.25
          k: 2
          reach: 0.06
          speed: 1.1
        script: scripts/material-banner-wave.js
      primitive:
        kind: scripted
        params:
          beast: lion
          field: oklch(0.38 0.14 262)
          field2: oklch(0.31 0.12 262)
          h: 11
          kind: drape
          point: 0.5
          trim: oklch(0.82 0.13 85)
          w: 4
        script: scripts/gen/town-banner.js
      visibleRange:
        max: 700
