# spawn-scene v2 yaml x4z5
sw-dwarf-engineering:
  id: sw-dwarf-engineering
  feetPosition:
    x: 360
    y: 0.55
    z: 520
  physics: static
  visibleRange:
    max: 700
  rotation:
    yaw: -90
  primitive:
    kind: scripted
    params:
      color: granite
      d: 16
      floors: 2
      h: 9.5
      roofStyle: gable
      w: 18
