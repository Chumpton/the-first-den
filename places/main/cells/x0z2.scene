royal-cathedral-nave:
  children: [{feetPosition: {x: 0, y: 5, z: 10.5}, id: altar-light, light: {color: "#ffc98a", distance: 22, intensity: 25, kind: point}}, {feetPosition: {x: 0, y: 12, z: 0}, id: nave-light, light: {color: "#fff1d8", distance: 34, intensity: 30, kind: point}}]
  feetPosition: {x: -34, y: 0.5, z: 196}
