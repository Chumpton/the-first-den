# ==========================================
# 4. STORMWIND KEEP (x: 25..105, z: 290..365, elevated on cliff at y: 13.5)
# ==========================================
sw-keep-stair:
  feetPosition: {x: 65, y: 0.55, z: 295}
  id: sw-keep-stair
  physics: static
  primitive: {kind: scripted, params: {part: stair}, script: scripts/gen/royal-castle.js}
