      visibleRange: {max: 90}
  feetPosition: {x: -46, y: 0.55, z: 235}
  id: sw-city-hall
  physics: static
  primitive: {kind: scripted, params: {color: limestone, d: 14, floors: 3, h: 10, roofStyle: gable, w: 18}, script: scripts/gen/stormwind-building.js, seed: 101}
  rotation: {yaw: 90}
  tags: [stormwind, cathedral, civic]
  visibleRange: {max: 500}

sw-cathedral-orphanage:
