      id: plaque-keep-gate
      material: {color: "oklch(0.32 0.1 262)"}
      primitive: {depth: 0.08, height: 0.9, kind: box, width: 5.5}
      ui: "<div face=\"front\" class=\"w-full h-full flex items-center justify-center text-center\" style=\"background:#1f2f6b;border:4px solid #d9b24c;color:#f2d27a;font-family:serif;font-size:220px;font-weight:bold;letter-spacing:6px\">STORMWIND KEEP</div>"
      visibleRange: {max: 90}
  feetPosition: {x: 65, y: 13.5, z: 312}
