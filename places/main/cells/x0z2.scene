    - castShadow: false
      feetPosition: {x: 0, y: 4.2, z: -6.1}
      id: plaque-orphanage
      material: {color: "oklch(0.32 0.1 262)"}
      primitive: {depth: 0.08, height: 0.65, kind: box, width: 4.2}
      ui: "<div face=\"front\" class=\"w-full h-full flex items-center justify-center text-center\" style=\"background:#1f2f6b;border:4px solid #d9b24c;color:#f2d27a;font-family:serif;font-size:170px;font-weight:bold;letter-spacing:4px\">STORMWIND ORPHANAGE</div>"
