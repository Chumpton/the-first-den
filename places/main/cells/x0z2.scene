# spawn-scene v2 yaml x0z2
# ==============================================================================
# STORMWIND CITY - NORTHERN DISTRICTS (Cathedral Square, Dwarven District, Keep)
# ==============================================================================

# ==========================================
# 1. CATHEDRAL SQUARE (x: -55..20, z: 200..275)
# ==========================================
sw-cathedral-of-light:
  children:
    - castShadow: false
      feetPosition: {x: 0, y: 5, z: 10.5}
      id: sw-altar-light
      light: {color: "#ffc98a", distance: 22, intensity: 25, kind: point}
    - castShadow: false
      feetPosition: {x: 0, y: 12, z: 0}
      id: sw-nave-light
      light: {color: "#fff1d8", distance: 34, intensity: 30, kind: point}
    - castShadow: false
      feetPosition: {x: 0, y: 4.5, z: -16.2}
      id: plaque-cathedral
      material: {color: "oklch(0.32 0.1 262)"}
      primitive: {depth: 0.08, height: 0.8, kind: box, width: 4.8}
      ui: "<div face=\"front\" class=\"w-full h-full flex items-center justify-center text-center\" style=\"background:#1f2f6b;border:4px solid #d9b24c;color:#f2d27a;font-family:serif;font-size:180px;font-weight:bold;letter-spacing:6px\">CATHEDRAL OF LIGHT</div>"
      visibleRange: {max: 90}
  feetPosition: {x: -16, y: 0.55, z: 255}
  id: sw-cathedral-of-light
  physics: static
  primitive: {kind: scripted, script: scripts/gen/royal-cathedral.js, seed: 1}
  rotation: {yaw: 0}
  tags: [stormwind, cathedral]
  visibleRange: {max: 900}

sw-cathedral-square-fountain:
  audio: {clip: /cdn/moodboard-lowpoly-cozy/sfx-stone-fountain-splash-loop.mp3, gain: 0.15, loop: true, maxDistance: 30, spatial: true}
  feetPosition: {x: -16, y: 0.55, z: 220}
  id: sw-cathedral-square-fountain
  physics: static
  primitive: {kind: scripted, params: {part: fountain}, script: scripts/gen/royal-district.js, seed: 3}
  tags: [stormwind, cathedral, fountain]
  visibleRange: {max: 250}

sw-city-hall:
  children:
    - castShadow: false
      feetPosition: {x: 0, y: 4.8, z: -7.1}
      id: plaque-city-hall
      material: {color: "oklch(0.32 0.1 262)"}
      primitive: {depth: 0.08, height: 0.7, kind: box, width: 4.6}
