      ui: "<div face=\"front\" class=\"w-full h-full flex items-center justify-center text-center\" style=\"background:#1f2f6b;border:4px solid #d9b24c;color:#f2d27a;font-family:serif;font-size:170px;font-weight:bold;letter-spacing:4px\">CLERGY RECTORY</div>"
