sw-keep-gatehouse:
  children:
    - castShadow: false
      feetPosition: {x: -4.4, y: 16.2, z: -5.4}
      id: keep-banner-l
      material: {kind: scripted, params: {ax: 0, ay: -0.25, k: 2, reach: 0.06, speed: 1.1}, script: scripts/material-banner-wave.js}
      primitive: {kind: scripted, params: {beast: lion, field: "oklch(0.38 0.14 262)", field2: "oklch(0.31 0.12 262)", h: 7, kind: drape, point: 0.5, trim: "oklch(0.82 0.13 85)", w: 1.6}, script: scripts/gen/town-banner.js}
      visibleRange: {max: 250}
    - castShadow: false
      feetPosition: {x: 4.4, y: 16.2, z: -5.4}
      id: keep-banner-r
