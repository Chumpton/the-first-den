# spawn-scene v2 yaml x0z2
sw-bank-of-stormwind:
  id: sw-bank-of-stormwind
  feetPosition:
    x: 8
    y: 0.55
    z: 232.6
  physics: static
  visibleRange:
    max: 700
  rotation:
    yaw: -90
  primitive:
    kind: scripted
    params:
      color: limestone
      d: 26
      floors: 3
      h: 12
      roofStyle: flat
      w: 22
    script: scripts/gen/stormwind-building.js
    seed: 312
  children:
    - castShadow: false
      feetPosition:
        x: 0
        y: 5.4
        z: -13.1
      id: plaque
      material:
        color: oklch(0.32 0.1 262)
      primitive:
        depth: 0.08
        height: 0.7
        kind: box
        width: 5.5
      ui: '<div face="front" class="w-full h-full flex items-center justify-center text-center" style="background:#1f2f6b;border:4px solid #d9b24c;color:#f2d27a;font-family:serif;font-size:160px;font-weight:bold;letter-spacing:4px">BANK OF STORMWIND</div>'
      visibleRange:
        max: 90
sw-bridge-trade-oldtown:
  id: sw-bridge-trade-oldtown
  feetPosition:
    x: 20.5
    y: 0.55
    z: 248.7
  physics: static
  visibleRange:
    max: 400
  rotation:
    yaw: 90
  primitive:
    kind: scripted
    params:
      len: 24
      w: 12
    script: scripts/gen/stormwind-bridge.js
