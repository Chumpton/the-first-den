  material: {pbr: true}
  primitive: {kind: scripted, params: {count: 5, kind: chanterelle}, script: scripts/gen/wild-mushroom.js, seed: 3}
  receiveShadow: true
  rotation: {yaw: 76}
  state: {kind: chanterelle, picked: false}
  tags: [interactable, wild-mushroom]
