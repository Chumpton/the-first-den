# spawn-scene v2 yaml x1z1
magic-district:
  feetPosition: {x: 82, y: 0.5, z: 78}
  id: magic-district
  material: {kind: scripted, script: engine/blueprint}
  physics: none
  primitive: {depth: 46, height: 6, kind: box, width: 46}
  tags: [blueprint]
wild-mushroom-09:
  behavior: scripts/wild-mushroom.js
  castShadow: false
  feetPosition: {x: 75.07, y: 0.773, z: 142.9}
