# spawn-scene v2 yaml x0z0
castle-keep:
  feetPosition: {x: 4, y: 23.55, z: 1}
  id: castle-keep
  material: {kind: scripted, script: engine/blueprint}
  physics: none
  primitive: {height: 25, kind: cylinder, radialSegments: 24, radiusBottom: 7, radiusTop: 7}
  tags: [castle]
den-life-butterflies:
  overrides:
    feetPosition: {x: 7.5, y: {terrain: 0}, z: -11}
  template: templates/den-life.js#butterflies
den-note-arch:
  overrides:
    feetPosition: {x: -2.2, y: {terrain: -0.05}, z: 33.1}
    rotation: {yaw: 0}
  template: templates/den-furniture.js#noteStake
den-note-arch/card:
  overrides:
    feetPosition: {x: 0, y: 0.95, z: -0.0012}
    parent: den-note-arch
    state.words: your first game starts here
  template: templates/den-furniture.js#note
den-note-garden:
  overrides:
    feetPosition: {x: 6.3, y: {terrain: -0.05}, z: -9.8}
    rotation: {yaw: 180}
  template: templates/den-furniture.js#noteStake
den-note-garden/card:
