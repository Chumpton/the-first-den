hive-site:
  audio: {clip: /cdn/moodboard-lowpoly-cozy/sfx-honeybee-hive-soft-hum-loop.mp3, gain: 0.12, loop: true, maxDistance: 12, spatial: true}
  castShadow: true
  feetPosition: {x: 31, y: 0.68, z: -46}
  fx: {script: "fx\npop bees n=?mobile:7|12 on=box(1.5,.35,.45).c(.95) life=2..3.5 v=sdir()*(.3..0.6) acc=curl(1.4)*2.2+drag(.9) size=.028..0.038 col=<1.25,.85,.12> a=0>.1:1>.9:1>0 sz=$size r=sprite(mote,alpha)\npop drones n=?mobile:3|6 on=box(1.5,.3,.45).c(.9) life=2..3.5 v=sdir()*(.3..0.5) acc=curl(1.4)*2.2+drag(.9) size=.024..0.03 col=<.12,.09,.04> a=0>.1:1>.9:1>0 sz=$size r=sprite(mote,alpha)\npop forage n=?mobile:3|6 on=disc(2) life=1.5..3 v=sdir()*(.2..0.4) acc=curl(.9)*1.6+drag(1) size=.028..0.034 col=<1.2,.8,.1> a=0>.15:1>.85:1>0 sz=$size r=sprite(mote,alpha)"}
  id: hive-site
  physics: static
  primitive: {kind: scripted, params: {kind: stand}, script: scripts/gen/hive-stand.js, seed: 7}
  receiveShadow: true
  rotation: {yaw: 120}
  tags: [homestead, hive]
