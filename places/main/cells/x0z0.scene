# spawn-scene v2 yaml x0z0
castle-keep:
  castShadow: true
  feetPosition: {x: 2, y: 24, z: 3}
  id: castle-keep
  material: {color: "#ffffff", pbr: true, roughness: 0.93}
  physics: static
  primitive: {kind: scripted, script: scripts/gen/castle-keep.js, seed: 7}
  receiveShadow: true
  state: {role: the stone keep that replaced the den}
  tags: [castle, castle-keep]
den-life-butterflies:
  overrides:
    feetPosition: {x: 7.5, y: {terrain: 0}, z: -11}
  template: templates/den-life.js#butterflies
den-note-arch:
  overrides:
    feetPosition: {x: -2.2, y: {terrain: -0.05}, z: 33.1}
    rotation: {yaw: 0}
  template: templates/den-furniture.js#noteStake
den-note-arch/card:
  overrides:
    feetPosition: {x: 0, y: 0.95, z: -0.0012}
    parent: den-note-arch
    state.words: your first game starts here
  template: templates/den-furniture.js#note
den-note-garden:
  overrides:
    feetPosition: {x: 6.3, y: {terrain: -0.05}, z: -9.8}
    rotation: {yaw: 180}
  template: templates/den-furniture.js#noteStake
den-note-garden/card:
  overrides:
    feetPosition: {x: 0, y: 0.95, z: -0.0012}
    parent: den-note-garden
    state.words: a little pond here?
  template: templates/den-furniture.js#note
