# spawn-scene v2 yaml x0z0
camp-spot:
  feetPosition: {x: -16, y: 0.5, z: -52}
  id: camp-spot
  material: {kind: scripted, script: engine/blueprint}
  physics: none
  primitive: {depth: 7, height: 2, kind: box, width: 7}
cob-house:
  castShadow: true
  feetPosition: {x: 0, y: 0.5, z: -26}
  id: cob-house
  physics: {body: static, collider: mesh}
  primitive: {kind: scripted, script: scripts/gen/cob-house.js}
  receiveShadow: true
  tags: [home, cob-house]
cob-house/cob-sun-cellar:
  feetPosition: {x: -2.8, y: -1.2, z: 1.6}
  id: cob-house/cob-sun-cellar
  light: {color: oklch(0.85 0.1 70), distance: 9, intensity: 14, kind: point}
  parent: cob-house
fireflies:
  feetPosition: {x: 0, y: 0.5, z: -40}
  fx: {script: "fx\npop flies n=?mobile:30|70 on=box(70,3,70).c(1.5) life=5..9 v=sdir()*.15 size=.035..0.06 acc=curl(.35)*.6+drag(.8) blink=0..6.28 col=hdr(2.6,3.4,.9) a=(0>.15:1>.85:1>0)*(.5+.5*sin($age*3+$blink))^3 sz=$size r=sprite(soft-disc,add)"}
  id: fireflies
  tags: [fireflies]
fireflies-camp:
  feetPosition: {x: -18, y: 0.5, z: -50}
  fx: {script: "fx\npop flies n=?mobile:10|24 on=box(18,2.5,18).c(1.2) life=4..8 v=sdir()*.15 size=.035..0.06 acc=curl(.4)*.6+drag(.8) blink=0..6.28 col=hdr(2.8,3.4,.9) a=(0>.15:1>.85:1>0)*(.5+.5*sin($age*3.4+$blink))^3 sz=$size r=sprite(soft-disc,add)"}
  id: fireflies-camp
  tags: [fireflies]
forest-ambience:
  audio: {bus: Ambience, clip: /cdn/moodboard-realistic-gritty/sfx-sunny-forest-birdsong-leaves-rustling-ambience-loop.mp3, gain: 0.18, loop: true, spatial: false}
  feetPosition: {x: 0, y: 1, z: 0}
  id: forest-ambience
home-garden:
  feetPosition: {x: -2, y: 0.5, z: -38}
  id: home-garden
  material: {kind: scripted, script: engine/blueprint}
  physics: none
  primitive: {depth: 20, height: 1.5, kind: box, width: 30}
  tags: [blueprint]
home-portal-stonework/home-portal-birch-left:
  overrides:
    feetPosition: {x: -3.7, y: 0.32795834792951695, z: 1.8}
    parent: home-portal-stonework
    primitive: {kind: scripted, params: {height: 4.7, spread: 1.2}, script: scripts/gen/home-garden-birch.js, seed: 653}
  template: templates/home-garden.js#birch
home-portal-stonework/home-portal-birch-right:
  overrides:
    feetPosition: {x: 3.4, y: 0.4874961314972275, z: 3}
    parent: home-portal-stonework
    primitive: {kind: scripted, params: {height: 5.1, spread: 1.35}, script: scripts/gen/home-garden-birch.js, seed: 659}
  template: templates/home-garden.js#birch
home-portal-stonework/home-portal-daisies-left:
  overrides:
    feetPosition: {x: -2.39, y: -0.1106895877793832, z: -1.23}
    parent: home-portal-stonework
    primitive: {kind: scripted, params: {flowerHeight: 0.18, flowerVariation: 0.08, flowers: 5, grassHeight: 0.1, grassVariation: 0.07, kind: meadow, rx: 0.32, rz: 0.48, tufts: 9}, script: scripts/gen/home-garden-planting.js, seed: 621}
  template: templates/home-garden.js#planting
home-portal-stonework/home-portal-daisies-right:
  overrides:
    feetPosition: {x: 2.26, y: -0.10680443057950484, z: -1.31}
    parent: home-portal-stonework
    primitive: {kind: scripted, params: {flowerHeight: 0.17, flowerVariation: 0.08, flowers: 4, grassHeight: 0.1, grassVariation: 0.06, kind: meadow, rx: 0.3, rz: 0.44, tufts: 8}, script: scripts/gen/home-garden-planting.js, seed: 629}
  template: templates/home-garden.js#planting
home-portal-stonework/home-portal-fern-left:
  overrides:
    feetPosition: {x: -2.49, y: -0.07623207471737459, z: 0.13}
    parent: home-portal-stonework
    primitive: {kind: scripted, params: {kind: fern}, script: scripts/gen/home-garden-planting.js, seed: 611}
  template: templates/home-garden.js#planting
home-portal-stonework/home-portal-fern-right:
  overrides:
    feetPosition: {x: 2.59, y: -0.050217923855523594, z: 0.92}
    parent: home-portal-stonework
    primitive: {kind: scripted, params: {kind: fern}, script: scripts/gen/home-garden-planting.js, seed: 613}
  template: templates/home-garden.js#planting
home-portal-stonework/home-portal-fieldstone-left:
  overrides:
    feetPosition: {x: -2.18, y: -0.07337102744494572, z: 0.94}
    parent: home-portal-stonework
    primitive: {kind: scripted, params: {d: 0.37, h: 0.2, w: 0.52}, script: scripts/gen/home-garden-rock.js, seed: 641}
  template: templates/home-garden.js#rock
home-portal-stonework/home-portal-fieldstone-right:
  overrides:
    feetPosition: {x: 2.32, y: -0.07965789507887422, z: 0.18}
    parent: home-portal-stonework
    primitive: {kind: scripted, params: {d: 0.32, h: 0.16, w: 0.4}, script: scripts/gen/home-garden-rock.js, seed: 647}
  template: templates/home-garden.js#rock
home-portal-stonework/home-portal-lantern-left:
  overrides:
    feetPosition: {x: -1.45, y: 0.1, z: -1.15}
    parent: home-portal-stonework
    rotation: 0
  template: templates/home-portal-stonework.js#lantern
home-portal-stonework/home-portal-lantern-right:
  overrides:
    feetPosition: {x: 1.45, y: 0.1, z: -1.15}
    parent: home-portal-stonework
    rotation: 0
  template: templates/home-portal-stonework.js#lantern
lake-dock:
  feetPosition: {x: 6, y: 0.3, z: -62}
  id: lake-dock
  material: {kind: scripted, script: engine/blueprint}
  physics: none
  primitive: {depth: 10, height: 0.4, kind: box, width: 2.4}
road-signpost:
  children: [{feetPosition: {x: 0.1, y: 2.35, z: 0}, id: arm-east, primitive: {kind: scripted, params: {dir: 1, kind: arm, len: 1.35}, script: scripts/gen/road-dressing.js}, ui: "<div face=\"front\" offset=\"0.004m\" style=\"width:1150px;height:250px;display:flex;align-items:center;justify-content:center;font-family:Georgia,serif;font-size:140px;font-weight:bold;color:#3a2718;white-space:nowrap\">Lumenvale →</div>"}, {feetPosition: {x: -0.1, y: 2, z: 0}, id: arm-west, primitive: {kind: scripted, params: {dir: -1, kind: arm, len: 1.35}, script: scripts/gen/road-dressing.js}, ui: "<div face=\"front\" offset=\"0.004m\" style=\"width:1150px;height:250px;display:flex;align-items:center;justify-content:center;font-family:Georgia,serif;font-size:140px;font-weight:bold;color:#3a2718;white-space:nowrap\">← Hearthmere</div>"}, {feetPosition: {x: 0, y: 1.65, z: -0.1}, id: arm-home, primitive: {kind: scripted, params: {dir: 1, kind: arm, len: 1.1}, script: scripts/gen/road-dressing.js}, rotation: {yaw: 90}, ui: "<div face=\"front\" offset=\"0.004m\" style=\"width:1150px;height:250px;display:flex;align-items:center;justify-content:center;font-family:Georgia,serif;font-size:140px;font-weight:bold;color:#3a2718;white-space:nowrap\">Home</div>"}]
  feetPosition: {x: 3.2, y: {terrain: 0}, z: 14.6}
  id: road-signpost
  physics: static
  primitive: {kind: scripted, params: {kind: signpost}, script: scripts/gen/road-dressing.js}
  rotation: {yaw: 0}
  tags: [road-dressing]
  visibleRange: {max: 200}
square-door:
  behavior: scripts/square-door.js
  children: [{castShadow: false, feetPosition: {x: 0, y: 0, z: 0.05}, id: glass, material: {color: "#000000", depthWrite: false, opacity: 0, transparent: true}, physics: none, primitive: {depth: 0.02, height: 2.42, kind: box, width: 1.12}, receiveShadow: false, visible: false}, {behavior: scripts/square-door.js, feetPosition: {x: 0, y: 0, z: 0.05}, id: passage, physics: {body: static, trigger: true}, primitive: {depth: 0.3, height: 2.2, kind: box, width: 0.9}, state: {kind: passage}, visible: false}, {behavior: scripts/square-door.js, feetPosition: {x: 0, y: -0.1, z: -1.6}, id: approach, physics: {body: static, trigger: true}, primitive: {depth: 3.2, height: 3, kind: box, width: 3}, state: {kind: approach}, visible: false}]
  feetPosition: {x: -6, y: 0.5, z: -5}
  physics: none
  rotation: {yaw: 180}
  state: {link: "@@squaresrc/the-square +main#den-door", near: 0, role: side-door-to-the-square}
  tags: [portal, den-side-door]
square-door-hinge:
  behavior: scripts/home-door.js
  feetPosition: {x: -0.545, y: 0, z: 0}
  parent: square-door
  rotation: {yaw: 180}
  state: {closedYaw: 180, currentYaw: 180, leafId: square-door-leaf, open: false, openYaw: 280, openingWidth: 1.1}
  tags: [home-architecture, door-hinge]
square-door-leaf:
  castShadow: true
  feetPosition: {x: 0, y: 0, z: 0}
  material: {color: "#ffffff", pbr: true, roughness: 0.83}
  parent: square-door-hinge
  physics: kinematic
  primitive: {kind: scripted, params: {height: 2.36, width: 1.09}, script: scripts/gen/home-architecture-door.js}
  receiveShadow: true
  state: {height: 2.36, hinge: square-door-hinge, width: 1.09}
  tags: [home-architecture, door-leaf]
square-door/frame-l:
  feetPosition: {x: -0.72, y: 0, z: 0}
  id: square-door/frame-l
  material: {color: oklch(0.93 0.01 85), roughness: 0.9}
  parent: square-door
  physics: static
  primitive: {depth: 0.4, height: 2.7, kind: box, width: 0.3}
square-door/frame-r:
  feetPosition: {x: 0.72, y: 0, z: 0}
  id: square-door/frame-r
  material: {color: oklch(0.93 0.01 85), roughness: 0.9}
  parent: square-door
  physics: static
  primitive: {depth: 0.4, height: 2.7, kind: box, width: 0.3}
square-door/lintel:
  feetPosition: {x: 0, y: 2.42, z: 0}
  id: square-door/lintel
  material: {color: oklch(0.93 0.01 85), roughness: 0.9}
  parent: square-door
  physics: static
  primitive: {depth: 0.46, height: 0.34, kind: box, width: 1.9}
square-door/sign:
  feetPosition: {x: 0, y: 3, z: 0}
  id: square-door/sign
  parent: square-door
  text: {color: oklch(0.35 0.03 250), content: to the square, size: 0.28}
sunbeams:
  feetPosition: {x: 0, y: 0.5, z: 0}
  fx: {script: "fx follow=camera\npop motes n=?mobile:60|160 on=box(24,8,24).c(3) wrap=24;8;24 life=4..7 v=up(.02..0.08)+sdir()*.05 size=.02..0.04 acc=curl(.2)*.2 col=hdr(1.6,1.4,.9) a=0>.3:.6>.7:.5>0 sz=$size r=sprite(mote,add)"}
  id: sunbeams
waylamp-east-0:
  feetPosition: {x: 35.209477844110445, y: {terrain: 0}, z: 10.689127905552567}
  id: waylamp-east-0
  physics: static
  primitive: {kind: scripted, params: {hue: 195, kind: lamp}, script: scripts/gen/road-dressing.js}
  rotation: {yaw: 215}
  tags: [road-dressing, waylamp, road-east]
  visibleRange: {max: 200}
