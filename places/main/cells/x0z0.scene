    audio: {bus: Music, clip: /cdn/moodboard-lowpoly-cozy/music-brushed-jazz-piano-upright-bass-instrumental-no-vocals-evening-loop.mp3, gain: 0.24, kind: clip, loop: true, maxDistance: 22, refDistance: 8, spatial: true}
