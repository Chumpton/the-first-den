    ui: "<div face=\"front\" emissive width=\"0.49m\" offset=\"-0.009m\" style=\"height:264px;padding-top:49px;display:flex;justify-content:flex-end;color:#f2e6cf;font-family:Georgia,serif\"><div style=\"width:150px;text-align:center\"><div style=\"font-size:20px;line-height:26px;color:#e8bc77\">{{ state.stationName }}</div><div style=\"font-size:11px;line-height:16px;letter-spacing:1px\">{{ state.frequency }} FM</div><div style=\"margin-top:6px;font-size:14px;line-height:19px;color:#f2e6cf\">{{ state.songTitle }}</div><div style=\"font-size:10px;line-height:14px;letter-spacing:1px;color:{{ state.indicator }}\">{{ state.broadcastLabel }}</div><div style=\"margin-top:8px;display:flex;gap:4px;justify-content:center\"><button id=\"power\" style=\"background:#403429;color:#f2e6cf;border:1px solid #a88550;padding:7px 3px;font-size:12px;font-family:Georgia,serif\">Power</button><button id=\"tune\" style=\"background:#403429;color:#f2e6cf;border:1px solid #a88550;padding:7px 3px;font-size:12px;font-family:Georgia,serif\">Tune</button><button id=\"next\" style=\"background:#403429;color:#f2e6cf;border:1px solid #a88550;padding:7px 3px;font-size:12px;font-family:Georgia,serif\">Next</button></div><div style=\"margin-top:4px;font-size:10px;line-height:14px;letter-spacing:1px;color:#c4a778\">{{ state.songNumber | pad 2 }} / {{ state.songCount | pad 2 }}</div></div></div>"
