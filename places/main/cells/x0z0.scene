square-door:
  behavior: scripts/square-door.js
  children: [{castShadow: false, feetPosition: {x: 0, y: 0, z: 0.05}, id: glass, material: {color: "#000000", depthWrite: false, opacity: 0, transparent: true}, physics: none, primitive: {depth: 0.02, height: 2.42, kind: box, width: 1.12}, receiveShadow: false, visible: false}, {behavior: scripts/square-door.js, feetPosition: {x: 0, y: 0, z: 0.05}, id: passage, physics: {body: static, trigger: true}, primitive: {depth: 0.3, height: 2.2, kind: box, width: 0.9}, state: {kind: passage}, visible: false}, {behavior: scripts/square-door.js, feetPosition: {x: 0, y: -0.1, z: -1.6}, id: approach, physics: {body: static, trigger: true}, primitive: {depth: 3.2, height: 3, kind: box, width: 3}, state: {kind: approach}, visible: false}]
  feetPosition: {x: 0, y: 0, z: -8}
  physics: none
  rotation: {yaw: 180}
  state: {link: "@@squaresrc/the-square +main#den-door", near: 0, role: side-door-to-the-square}
  tags: [portal, den-side-door]
square-door-hinge:
  behavior: scripts/home-door.js
  feetPosition: {x: -0.545, y: 0, z: 0}
  parent: square-door
  rotation: {yaw: 180}
  state: {closedYaw: 180, currentYaw: 180, leafId: square-door-leaf, open: false, openYaw: 280, openingWidth: 1.1}
  tags: [home-architecture, door-hinge]
square-door-leaf:
  castShadow: true
  feetPosition: {x: 0, y: 0, z: 0}
  material: {color: "#ffffff", pbr: true, roughness: 0.83}
  parent: square-door-hinge
  physics: kinematic
  primitive: {kind: scripted, params: {height: 2.36, width: 1.09}, script: scripts/gen/home-architecture-door.js}
  receiveShadow: true
  state: {height: 2.36, hinge: square-door-hinge, width: 1.09}
  tags: [home-architecture, door-leaf]
square-door/frame-l:
  feetPosition: {x: -0.72, y: 0, z: 0}
  id: square-door/frame-l
  material: {color: oklch(0.93 0.01 85), roughness: 0.9}
  parent: square-door
  physics: static
  primitive: {depth: 0.4, height: 2.7, kind: box, width: 0.3}
square-door/frame-r:
  feetPosition: {x: 0.72, y: 0, z: 0}
  id: square-door/frame-r
  material: {color: oklch(0.93 0.01 85), roughness: 0.9}
  parent: square-door
  physics: static
  primitive: {depth: 0.4, height: 2.7, kind: box, width: 0.3}
square-door/lintel:
