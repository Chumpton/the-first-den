# spawn-scene v2 yaml x1z6
sw-cathedral-of-light:
  id: sw-cathedral-of-light
  feetPosition:
    x: 68.4
    y: 0.55
    z: 640.2
  physics: static
  visibleRange:
    max: 950
  rotation:
    yaw: 180
  primitive:
    kind: scripted
    script: scripts/gen/royal-cathedral.js
    seed: 1
  children:
    - castShadow: false
      feetPosition:
        x: 0
        y: 5
        z: 10.5
      id: sw-altar-light
      light:
        color: "#ffc98a"
        distance: 25
        intensity: 30
        kind: point
    - castShadow: false
      feetPosition:
        x: 0
        y: 14
        z: 0
      id: sw-nave-light
      light:
        color: "#fff1d8"
        distance: 40
        intensity: 35
        kind: point
    - castShadow: false
      feetPosition:
        x: 0
        y: 4.5
        z: -16.2
      id: plaque-cathedral
      material:
        color: oklch(0.32 0.1 262)
      primitive:
        depth: 0.08
        height: 0.8
        kind: box
        width: 5.2
      ui: '<div face="front" class="w-full h-full flex items-center justify-center text-center" style="background:#1f2f6b;border:4px solid #d9b24c;color:#f2d27a;font-family:serif;font-size:180px;font-weight:bold;letter-spacing:6px">CATHEDRAL OF LIGHT</div>'
      visibleRange:
        max: 90
sw-fellowship-hall:
  id: sw-fellowship-hall
  feetPosition:
    x: 120
    y: 0.55
    z: 560
  physics: static
  visibleRange:
    max: 700
  rotation:
