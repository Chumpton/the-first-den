      feetPosition:
        x: 0
        y: 4.5
        z: -9.1
      id: plaque
      material:
        color: oklch(0.32 0.1 262)
      primitive:
        depth: 0.08
        height: 0.7
        kind: box
        width: 5.5
      ui: '<div face="front" class="w-full h-full flex items-center justify-center text-center" style="background:#1f2f6b;border:4px solid #d9b24c;color:#f2d27a;font-family:serif;font-size:160px;font-weight:bold;letter-spacing:4px">FELLOWSHIP HALL</div>'
      visibleRange:
